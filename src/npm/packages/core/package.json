{
  "name": "@laczynski/datagrid",
  "version": "0.1.0-preview.16",
  "description": "Framework-agnostic GridQuery/GridResult types for DataGrid.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laczynski/DataGrid.git"
  },
  "homepage": "https://github.com/laczynski/DataGrid#readme",
  "bugs": {
    "url": "https://github.com/laczynski/DataGrid/issues"
  },
  "keywords": [
    "datagrid",
    "grid",
    "pagination",
    "filtering",
    "sorting",
    "datagrid"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "~6.0.0",
    "vitest": "^3.2.4"
  }
