{
  "name": "@laczynski/datagrid-cli",
  "version": "0.1.0-preview.18",
  "description": "Angular schematics for DataGrid Spartan helm customization.",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Laczynski/DataGrid.git"
  },
  "homepage": "https://github.com/Laczynski/DataGrid#readme",
  "bugs": {
    "url": "https://github.com/Laczynski/DataGrid/issues"
  },
  "keywords": [
    "datagrid",
    "angular",
    "schematics",
    "spartan"
  ],
  "publishConfig": {
    "access": "public"
  },
  "schematics": "./collection.json",
  "scripts": {
    "prebuild": "node ../../../../scripts/sync-spartan-schematic-files.mjs",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node ./scripts/build.mjs",
    "test": "node ../../../../scripts/sync-spartan-schematic-files.mjs && node ./schematics/spartan-grid/index.spec.cjs"
  },
  "dependencies": {
    "@angular-devkit/core": "^22.0.0",
    "@angular-devkit/schematics": "^22.0.0"
  },
  "peerDependencies": {
    "@angular/cli": "^22.0.0"
  },
  "devDependencies": {
    "@angular-devkit/schematics": "^22.0.0"
  },
  "files": [
    "collection.json",
    "schematics",
    "README.md"
  ]
}
